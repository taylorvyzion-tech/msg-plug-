{
  "name": "chatbot-saas-starter",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant chatbot platform for barbershops and hair salons.",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma migrate dev --name barber_pack"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
