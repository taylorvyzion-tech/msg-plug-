# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

PORT=3000

# Local SQLite database (default)
DATABASE_URL="file:./dev.db"

# Long random string. Protects every /api admin endpoint.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY="replace-me-with-a-long-random-string"

# --- SMS alerts on new bookings (optional) --------------------------------
# Without these the app runs fine; it just won't text anyone.
# Get them from https://console.twilio.com after buying a number (~$1.15/mo,
# ~$0.0079 per text in the US).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Country code assumed for numbers typed without one. +1 = US/Canada.
SMS_DEFAULT_COUNTRY="+1"
